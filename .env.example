# Copy to .env for local development. Never commit a real key.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_TO=hola@letsdaydream.ai

# Must use a Resend-verified sender. Use the onboarding sender until
# letsdaydream.ai is verified in Resend, then switch to:
#   Daydream <hola@letsdaydream.ai>
CONTACT_FROM=Daydream <onboarding@resend.dev>
